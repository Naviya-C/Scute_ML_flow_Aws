# =====================================================================
# API + worker config. On the VM: copy to .env next to docker-compose.yml
# Comments must stay on their own lines (docker --env-file does not strip them).
# =====================================================================

# development while testing, production when live
ENV=development

# AWS RDS PostgreSQL (16+ with pgvector). RDS requires TLS.
DATABASE_URL=postgresql://turtle_admin:<PASSWORD>@<instance>.<id>.ap-southeast-2.rds.amazonaws.com:5432/turtle?sslmode=require

# Private S3 bucket(s). Browser uploads land in incoming/ (quarantine); the worker moves images
# that pass the turtle gate to accepted/ and deletes the rest. Access is by IAM role, not keys.
# Same bucket with two prefixes for now; use two buckets later by changing only these values.
S3_INCOMING_BUCKET=your-turtle-bucket
S3_INCOMING_PREFIX=incoming/
S3_ACCEPTED_BUCKET=your-turtle-bucket
S3_ACCEPTED_PREFIX=accepted/
AWS_REGION=ap-southeast-2
# Commit SHA of the images CI pushed to ECR (see the Actions run); required by docker compose
IMAGE_TAG=

# Photos every submission must contain (the rest are optional).
# REQUIRED_SLOTS=whole,left,right

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_KEYS: for the frontend's backend; comma-separate two keys while rotating
API_KEYS=change-me
# ADMIN_KEYS: only you
ADMIN_KEYS=change-me

# Empty = server-to-server only (recommended). Set origins only if a browser calls the API directly.
CORS_ORIGINS=

# true locally, false in production
ENABLE_DOCS=true

# GPU worker. In docker compose this is set automatically.
# WORKER_URL=http://worker:9000

# Worker model weights. WEIGHTS_DIR is mounted read-only at /weights in the worker
# (default ./models next to docker-compose.yml). Weights are never committed or baked into the image.
# WEIGHTS_DIR=/opt/scute/weights
# DETECT_MODEL_PATH=/weights/detection_v1.pth
# SEG_MODEL_PATH=/weights/seg-yolo26n.pt
# DETECT_MIN_CONF=0.5
# DETECT_PAD=0.10
# Embedding versions: full photos, detector crops and segmented scutes must never be compared, so
# each gets its own EMBED_MODEL_VERSION (the worker refuses to start on a mismatch).
#   detector + segmenter (default):  EMBED_MODEL_VERSION=dinov2-base-seg-v1
#   detector only:  SEG_MODEL_PATH=  EMBED_MODEL_VERSION=dinov2-base-det-v1  SEG_MODEL_VERSION=none
#   no models (old full-photo behaviour):  DETECT_MODEL_PATH=  SEG_MODEL_PATH=
#                                          EMBED_MODEL_VERSION=dinov2-base-v1  SEG_MODEL_VERSION=none

# Optional tuning
# RATE_LIMIT_PER_UID=10
# RATE_LIMIT_PER_KEY=300
